generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id            String         @id
  name          String
  phone         String
  initial       String
  tenantId      String         @default("tenant-demo") @map("tenant_id")
  conversations Conversation[]

  @@map("customers")
}

model Conversation {
  id            String            @id
  customerId    String            @map("customer_id")
  channel       String            @default("whatsapp")
  lastMessage   String            @map("last_message")
  status        String
  assignee      String
  unread        Int               @default(0)
  windowExpired Int               @default(0) @map("window_expired")
  lastActivityAt String           @default("") @map("last_activity_at")
  tenantId      String            @default("tenant-demo") @map("tenant_id")
  botRanAt      String            @default("") @map("bot_ran_at")
  botWaitingNodeId String         @default("") @map("bot_waiting_node_title")
  offHoursNotifiedAt String       @default("") @map("off_hours_notified_at")
  customer      Customer          @relation(fields: [customerId], references: [id])
  messages      Message[]
  tags          ConversationTag[]

  @@map("conversations")
}

model Message {
  id             String       @id
  conversationId String       @map("conversation_id")
  direction      String
  text           String
  time           String
  createdAt      String       @default("") @map("created_at")
  author         String       @default("")
  attachmentType String       @default("") @map("attachment_type")
  attachmentUrl  String       @default("") @map("attachment_url")
  attachmentName String       @default("") @map("attachment_name")
  attachmentMime String       @default("") @map("attachment_mime")
  metaMediaId    String       @default("") @map("meta_media_id")
  sourceType     String       @default("") @map("source_type")
  sourceId       String       @default("") @map("source_id")
  sourceUrl      String       @default("") @map("source_url")
  sourceLabel    String       @default("") @map("source_label")
  replyToMessageId String     @default("") @map("reply_to_message_id")
  replyToText      String     @default("") @map("reply_to_text")
  replyToAuthor    String     @default("") @map("reply_to_author")
  deliveryStatus   String     @default("") @map("delivery_status")
  deliveryError    String     @default("") @map("delivery_error")
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@map("messages")
}

model Employee {
  id          String       @id
  name        String
  role        String
  status      String
  permissions String
  email       String
  initial     String
  tenantId    String       @default("tenant-demo") @map("tenant_id")
  teams       TeamMember[]

  @@map("employees")
}

model Team {
  id        String       @id
  tenantId  String       @default("tenant-demo") @map("tenant_id")
  name      String
  lead      String
  routing   String
  members   TeamMember[]

  @@map("teams")
}

model TeamMember {
  teamId     String   @map("team_id")
  employeeId String   @map("employee_id")
  team       Team     @relation(fields: [teamId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@id([teamId, employeeId])
  @@map("team_members")
}

model Tag {
  id          String @id
  name        String
  color       String
  description String
  tenantId    String @default("tenant-demo") @map("tenant_id")

  @@map("tags")
}

model ConversationTag {
  conversationId String       @map("conversation_id")
  tagName        String       @map("tag_name")
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@id([conversationId, tagName])
  @@map("conversation_tags")
}

model Template {
  id          String @id
  tenantId    String @default("tenant-demo") @map("tenant_id")
  name        String
  message     String
  type        String
  category    String @default("MARKETING")
  language    String
  status      String
  headerType  String @default("NONE") @map("header_type")
  headerText  String @default("") @map("header_text")
  headerMedia String @default("") @map("header_media")
  footer      String @default("")
  buttonType  String @default("NONE") @map("button_type")
  buttonText  String @default("") @map("button_text")
  buttonPhone String @default("") @map("button_phone")
  buttonUrl   String @default("") @map("button_url")
  metaId      String @default("") @map("meta_id")
  syncedAt    String @default("-") @map("synced_at")
  lastUsed    String @map("last_used")

  @@unique([name, tenantId])
  @@map("templates")
}

model QuickReply {
  id       String @id
  tenantId String @default("tenant-demo") @map("tenant_id")
  shortcut String
  text     String
  team     String
  usage    Int    @default(0)

  @@map("quick_replies")
}

model AutomationRule {
  id          String @id
  tenantId    String @default("tenant-demo") @map("tenant_id")
  name        String
  description String
  trigger     String @default("رسالة واردة")
  action      String @default("تعيين المحادثة")
  target      String @default("بدون موظف")
  delayMinutes Int   @default(0) @map("delay_minutes")
  conditionsJson String @default("[]") @map("conditions_json")
  actionsJson    String @default("[]") @map("actions_json")
  createdAt   String @map("created_at")
  enabled     Int    @default(1)

  @@map("automation_rules")
}

model AutomationQueueItem {
  id             String @id
  ruleId         String @map("rule_id")
  conversationId String @map("conversation_id")
  tenantId       String @default("tenant-demo") @map("tenant_id")
  runAt          String @map("run_at")
  createdAt      String @map("created_at")

  @@map("automation_queue")
}

model Campaign {
  id           String @id
  tenantId     String @default("tenant-demo") @map("tenant_id")
  name         String
  channel      String @default("whatsapp")
  templateName String @default("") @map("template_name")
  language     String @default("ar") @map("language")
  scheduledAt  String @default("") @map("scheduled_at")
  sent         Int    @default(0)
  total        Int    @default(0)
  progress     String
  status       String
  updatedAt    String @map("updated_at")

  @@map("campaigns")
}

model CampaignRecipient {
  id         String @id
  campaignId String @map("campaign_id")
  tenantId   String @default("tenant-demo") @map("tenant_id")
  phone      String
  name       String @default("")
  status     String @default("قيد الإرسال")
  error      String @default("")
  messageId  String @default("") @map("message_id")
  sentAt     String @default("") @map("sent_at")
  createdAt  String @map("created_at")

  @@map("campaign_recipients")
}

model CampaignBalance {
  tenantId  String @id @map("tenant_id")
  balance   Int    @default(0)
  updatedAt String @map("updated_at")

  @@map("campaign_balances")
}

model CampaignPayment {
  id          String @id
  tenantId    String @map("tenant_id")
  messages    Int
  amount      Float
  status      String @default("قيد الانتظار")
  moyasarId   String @default("") @map("moyasar_id")
  paymentUrl  String @default("") @map("payment_url")
  createdAt   String @map("created_at")
  completedAt String @default("") @map("completed_at")

  @@map("campaign_payments")
}

model WorkSchedule {
  id       String @id
  tenantId String @default("tenant-demo") @map("tenant_id")
  team     String
  days     String
  start    String
  end      String
  status   String
  holidays String

  @@map("work_schedules")
}

model Lead {
  id          String @id
  customer    String
  phone       String @default("")
  interest    String
  budget      String
  source      String @default("")
  notes       String @default("")
  stage       String
  employee    String
  lastContact String @map("last_contact")
  tenantId    String @default("tenant-demo") @map("tenant_id")

  @@map("leads")
}

model IntegrationSetting {
  id            String @id
  provider      String
  status        String
  businessName  String @map("business_name")
  wabaName      String @map("waba_name")
  phoneNumber   String @map("phone_number")
  phoneNumberId String @map("phone_number_id")
  wabaId        String @map("waba_id")
  appId         String @map("app_id")
  configId      String @default("") @map("config_id")
  verifyToken   String @map("verify_token")
  accessToken   String @map("access_token")
  xConsumerKey  String @default("") @map("x_consumer_key")
  xConsumerSecret String @default("") @map("x_consumer_secret")
  xBearerToken String @default("") @map("x_bearer_token")
  xAccessToken String @default("") @map("x_access_token")
  xAccessTokenSecret String @default("") @map("x_access_token_secret")
  googleAccountId String @default("") @map("google_account_id")
  googleLocationId String @default("") @map("google_location_id")
  googleRefreshToken String @default("") @map("google_refresh_token")
  webhookUrl    String @map("webhook_url")
  updatedAt     String @map("updated_at")

  @@map("integration_settings")
}

model UserAccount {
  id              String @id
  name            String
  email           String @unique
  passwordHash    String @map("password_hash")
  role            String
  tenantId        String @default("tenant-demo") @map("tenant_id")
  profileLogo     String @default("") @map("profile_logo")
  isPlatformAdmin Int    @default(0) @map("is_platform_admin")
  sessionVersion  Int    @default(0) @map("session_version")
  createdAt       String @map("created_at")

  @@map("user_accounts")
}

model EmployeeInvite {
  id        String @id
  email     String
  tokenHash String @unique @map("token_hash")
  expiresAt String @map("expires_at")
  createdAt String @map("created_at")

  @@map("employee_invites")
}

model EmailIntegration {
  id            String @id
  provider      String
  status        String
  senderName    String @default("") @map("sender_name")
  emailAddress  String @default("") @map("email_address")
  webhookSecret String @default("") @map("webhook_secret")
  accessToken   String @default("") @map("access_token")
  refreshToken  String @default("") @map("refresh_token")
  tokenExpiresAt String @default("") @map("token_expires_at")
  lastSyncedAt  String @default("") @map("last_synced_at")
  updatedAt     String @map("updated_at")

  @@map("email_integrations")
}

model ProviderClient {
  id                 String @id
  company            String
  owner              String
  plan               String
  status             String
  subscriptionStatus String @map("subscription_status")
  renewal            String
  phone              String
  wabaId             String @map("waba_id")
  conversations      Int    @default(0)
  employees          Int    @default(0)
  lastActivity       String @map("last_activity")
  createdAt          String @map("created_at")

  @@map("provider_clients")
}

model ProviderSubscription {
  id            String @id
  clientId      String @map("client_id")
  clientName    String @map("client_name")
  plan          String
  status        String
  amount        Int    @default(0)
  renewal       String
  billingCycle  String @map("billing_cycle")
  paymentMethod String @map("payment_method")

  @@map("provider_subscriptions")
}

model Plan {
  id            String @id
  name          String @unique
  monthlyPrice  Int    @default(0) @map("monthly_price")
  employeeLimit Int    @default(1) @map("employee_limit")
  sortOrder     Int    @default(0) @map("sort_order")
  active        Int    @default(1)
  createdAt     String @map("created_at")
  updatedAt     String @map("updated_at")

  @@map("plans")
}

model Subscription {
  id            String @id
  tenantId      String @unique @map("tenant_id")
  companyName   String @map("company_name")
  ownerName     String @map("owner_name")
  ownerEmail    String @map("owner_email")
  plan          String @default("باقة النمو")
  status        String @default("تجربة")
  employeeLimit Int    @default(3) @map("employee_limit")
  leadsEnabled  Int    @default(1) @map("leads_enabled")
  amount        Int    @default(0)
  billingCycle  String @default("شهري") @map("billing_cycle")
  renewalAt     String @default("") @map("renewal_at")
  createdAt     String @map("created_at")
  updatedAt     String @map("updated_at")

  @@map("subscriptions")
}

model SubscriptionPayment {
  id          String @id
  tenantId    String @map("tenant_id")
  amount      Float
  status      String @default("قيد الانتظار")
  moyasarId   String @default("") @map("moyasar_id")
  paymentUrl  String @default("") @map("payment_url")
  createdAt   String @map("created_at")
  completedAt String @default("") @map("completed_at")

  @@map("subscription_payments")
}

model BotSettings {
  id        String @id
  tenantId  String @map("tenant_id")
  channel   String @default("whatsapp")
  enabled   Int    @default(0)
  updatedAt String @map("updated_at")

  @@map("bot_settings")
}

model BotNode {
  id        String @id
  tenantId  String @map("tenant_id")
  channel   String @default("whatsapp")
  position  Int    @default(0)
  type      String
  title     String
  content   String
  canvasX   Float  @default(0) @map("canvas_x")
  canvasY   Float  @default(0) @map("canvas_y")
  createdAt String @map("created_at")

  @@map("bot_nodes")
}

model AdminLog {
  id         String @id
  at         String
  clientId   String @map("client_id")
  clientName String @map("client_name")
  source     String
  level      String
  message    String

  @@map("admin_logs")
}

model RateLimit {
  key     String @id
  count   Int    @default(0)
  resetAt String @map("reset_at")

  @@map("rate_limits")
}
