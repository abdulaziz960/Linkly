SUPER_ADMIN_NAME="Abdulaziz"
SUPER_ADMIN_BOOTSTRAP_PASSWORD=""
# Opt in only for a dedicated E2E environment. Never enable on a real tenant.
E2E_SEED_ENABLED=""
NEXT_PUBLIC_APP_URL="https://audiencew.audience.sa"
APP_URL="https://audiencew.audience.sa"
CRON_SECRET="generate-a-long-random-secret"

# OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
META_APP_ID=""
META_APP_SECRET=""
FACEBOOK_APP_SECRET=""
WHATSAPP_META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
META_CONFIG_ID=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Billing
MOYASAR_SECRET_KEY=""
MOYASAR_WEBHOOK_SECRET=""
