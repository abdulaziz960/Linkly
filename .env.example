# Core runtime (required in production)
DATABASE_URL=""
AUTH_SECRET="generate-a-long-random-secret"
INTEGRATION_ENCRYPTION_KEY="generate-a-different-long-random-secret"
# Existing deployments may use these aliases instead:
OAUTH_STATE_SECRET=""
ENCRYPTION_KEY=""
DEMO_LOGIN_PASSWORD=""
# Optional one-time bootstrap. The password is only applied while this
# account has no password yet; remove it from the environment after first use.
