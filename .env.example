# Core runtime (required in production)
DATABASE_URL=""
AUTH_SECRET="generate-a-long-random-secret"
INTEGRATION_ENCRYPTION_KEY="generate-a-different-long-random-secret"
# Existing deployments may use these aliases instead:
OAUTH_STATE_SECRET=""
ENCRYPTION_KEY=""
DEMO_LOGIN_PASSWORD=""
# Optional one-time bootstrap. Prefer `npm run admin:create`; do not reuse a
# tenant-owner email as a Platform Admin email.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_BOOTSTRAP_PASSWORD=""
PLATFORM_ADMIN_EMAILS=""
# Opt in only for a dedicated E2E environment. Never enable on a real tenant.
E2E_SEED_ENABLED=""
NEXT_PUBLIC_APP_URL="https://linklysa.io"
APP_URL="https://linklysa.io"
# Marketing-site WhatsApp CTA button. Public phone number, not a secret -
# but on Cloud Run it must be set as the `_SALES_WHATSAPP_NUMBER` Cloud
# Build substitution (see cloudbuild.yaml), not a runtime env var, since
# NEXT_PUBLIC_* vars are inlined into the client bundle at build time.
NEXT_PUBLIC_SALES_WHATSAPP_NUMBER=""
# Workspace receiving that sales WhatsApp number. Click tokens are accepted
# only by inbound messages routed to this same tenant.
ATTRIBUTION_TENANT_ID="tenant-demo"
# Enables the inbox's "suggest reply" AI button (Gemini). Runtime-only -
# a normal Cloud Run env var works fine, no rebuild needed.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Web Push (the dashboard's "ثبّت التطبيق" install button / new-message
# notifications). Generate once with `npx web-push generate-vapid-keys` and
# never change them afterward - rotating the key pair invalidates every
# device's existing subscription. Runtime-only, no rebuild needed.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@linklysa.io"
CRON_SECRET="generate-a-long-random-secret"
# Only enable during a controlled production repair window. Normal production
# schema changes should be applied through Prisma migrations.
ENABLE_RUNTIME_SCHEMA_REPAIR=""
# Set to true only behind a trusted reverse proxy that strips and rewrites
# client-supplied forwarding headers. Vercel sets trusted proxy headers itself.
TRUST_PROXY_HEADERS=""

# OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
META_APP_ID=""
META_APP_SECRET=""
FACEBOOK_APP_SECRET=""
WHATSAPP_META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
META_CONFIG_ID=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# Community Management API product must be requested and approved per-app in
# the LinkedIn Developer Portal, tied to a verified Company Page.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Snapchat Marketing API - Lead Generation Ads. Requires Snap Business/
# Marketing API approval; the channel stays locked ("coming soon") in
# Settings until credentials are present and approval is granted.
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""
# Only needed if/once Snap grants a real-time lead webhook for this app;
# leave blank to rely solely on the /api/cron/snapchat-leads poller.
SNAPCHAT_WEBHOOK_VERIFY_TOKEN=""

# Billing (see docs/payments.md)
# sk_test_… keys run against Moyasar's sandbox; sk_live_… charges real cards.
MOYASAR_SECRET_KEY=""
# Shared secret configured on the Moyasar dashboard's account-level
# "Payments Webhooks"; the invoice callback_url carries no secret and is
# verified by re-fetching the invoice from Moyasar instead.
MOYASAR_WEBHOOK_SECRET=""
# Moyasar's public/publishable key (pk_test_.../pk_live_...), from the same
# API Keys page as MOYASAR_SECRET_KEY. Safe to expose client-side by design -
# powers the embedded card form at /billing/pay/[paymentId] (Moyasar.js).
# On Cloud Run this must be set as the `_MOYASAR_PUBLISHABLE_KEY` Cloud
# Build substitution (see cloudbuild.yaml), not a runtime env var, for the
# same NEXT_PUBLIC_* build-time-inlining reason as _SALES_WHATSAPP_NUMBER.
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=""
# Test-mode-only alternate gateway for admin-created invoices.
STRIPE_SECRET_KEY=""
# Days an ACTIVE subscription may run past its paid-through date (renewal_at)
# before the workspace is locked to /billing like an expired trial. Leave
# blank to never lock out paying customers for non-renewal (they only show
# as overdue in the admin panel). Example: 7
SUBSCRIPTION_GRACE_DAYS=""

# Production database access (docs/database-access.md): the password goes in
# .env.db via `npm run db:env` - NOT in .env / .env.local, which Next.js
# loads (that would point `npm run dev` at production).
#   npm run db:proxy   # Cloud SQL Auth Proxy on 127.0.0.1:6543
#   npm run db:check   # read-only report

# Transactional email (activation/reset links) when no tenant has connected
# Gmail/Outlook yet. Resend is tried first if configured - requires a
# verified sending domain (SPF/DKIM/DMARC) for reliable delivery to every
# provider, not just Gmail. Falls back to the Google Apps Script sender below
# (a script bound to a personal Gmail account, deployed as a web app, that
# sends via GmailApp.sendEmail() - unreliable for non-Google recipients).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Linkly <noreply@linklysa.io>"
GOOGLE_APPS_SCRIPT_URL=""
GOOGLE_APPS_SCRIPT_SECRET=""
