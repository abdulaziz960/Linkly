# Transactional email fallback (activation/reset links) when no tenant
# has connected Gmail/Outlook yet - a Google Apps Script bound to a Gmail
# account, deployed as a web app, that sends mail via GmailApp.sendEmail()
GOOGLE_APPS_SCRIPT_URL=""
GOOGLE_APPS_SCRIPT_SECRET=""
